<style>
:root{
  --bg:#17100A; --panel:#1E150A; --panel2:#241A0C; --well:#150E05;
  --cream:#FFF2D9; --cream70:rgba(255,242,217,.7); --cream50:rgba(255,242,217,.5); --cream35:rgba(255,242,217,.35);
  --line:rgba(255,238,205,.16); --line2:rgba(255,238,205,.30);
  --honey:#FFB23E; --honey-d:#E8940F; --red:#E5484D; --sage:#9CC177; --ink:#241B0E;
}
*{box-sizing:border-box;margin:0;padding:0}
html,body{height:100%}
body{font-family:'Bricolage Grotesque',sans-serif;background:var(--bg);color:var(--cream);display:flex;flex-direction:column;overflow:hidden;-webkit-font-smoothing:antialiased}
::selection{background:var(--honey);color:var(--ink)}
button{font-family:inherit;color:inherit;background:none;border:none;cursor:pointer}
kbd{font:500 9.5px 'IBM Plex Mono';border:1px solid var(--cream35);border-radius:5px;padding:1px 5px 2px;color:var(--cream50)}
::-webkit-scrollbar{width:8px}
::-webkit-scrollbar-thumb{background:rgba(255,238,205,.18);border-radius:4px;border:2px solid var(--bg)}
::-webkit-scrollbar-track{background:transparent}

header{display:flex;align-items:center;gap:14px;padding:9px 18px;flex:none;background:#1B1207;border-bottom:1.5px solid var(--line2)}
.mark{display:flex;align-items:center;gap:10px}
.mark h1{font-size:19px;font-weight:800;letter-spacing:-.02em}
.mark .sub{font:500 9px 'IBM Plex Mono';letter-spacing:.14em;color:var(--cream50);line-height:1.5;text-transform:uppercase}
header .right{margin-left:auto;display:flex;align-items:center;gap:10px}
#fps{font:500 10px 'IBM Plex Mono';letter-spacing:.1em;color:var(--cream50)}
.btn{display:inline-flex;align-items:center;gap:7px;font-weight:600;font-size:12.5px;padding:7px 12px;border:1.5px solid var(--line2);border-radius:10px;transition:background .14s,color .14s,border-color .14s,transform .08s}
.btn:hover{background:var(--honey);color:var(--ink);border-color:var(--ink)}
.btn:active{transform:translateY(1px)}
.btn.prime{background:var(--honey);color:var(--ink);border-color:var(--ink)}
.btn.prime:hover{background:var(--honey-d)}
#sndBtn .x{display:none}
#sndBtn.muted .w{display:none}
#sndBtn.muted .x{display:block}

main{flex:1;display:grid;grid-template-columns:1fr 344px;min-height:0}

/* stage */
#stage{position:relative;margin:16px;border:1.5px solid var(--line2);border-radius:20px;overflow:hidden;background:var(--panel2);
  background-image:url("data:image/svg+xml,%3Csvg width='56' height='98' viewBox='0 0 28 49' xmlns='http://www.w3.org/2000/svg'%3E%3Cg fill='none' stroke='%23FFF6E4' stroke-opacity='.05'%3E%3Cpath d='M13.99 9.25l13 7.5v15l-13 7.5L.99 31.75v-15l13-7.5zM3 17.45v14.1l10.99 6.34 11.01-6.35v-14.1L14 11.11z'/%3E%3C/g%3E%3C/svg%3E");
  background-size:56px 98px;display:flex;align-items:center;justify-content:center}
#stage.light{background-color:var(--panel);
  background-image:url("data:image/svg+xml,%3Csvg width='56' height='98' viewBox='0 0 28 49' xmlns='http://www.w3.org/2000/svg'%3E%3Cg fill='none' stroke='%23241B0E' stroke-opacity='.06'%3E%3Cpath d='M13.99 9.25l13 7.5v15l-13 7.5L.99 31.75v-15l13-7.5zM3 17.45v14.1l10.99 6.34 11.01-6.35v-14.1L14 11.11z'/%3E%3C/g%3E%3C/svg%3E")}
.stage-tag{position:absolute;top:13px;left:15px;font:600 9.5px 'IBM Plex Mono';letter-spacing:.16em;color:var(--cream35);text-transform:uppercase;pointer-events:none}
.stage-hint{position:absolute;bottom:12px;left:15px;font:500 9.5px 'IBM Plex Mono';letter-spacing:.04em;color:var(--cream35);pointer-events:none}
#stage.light .stage-tag,#stage.light .stage-hint{color:var(--cream50)}
#chipLight{position:absolute;top:11px;right:13px}
#chipLight.on{background:var(--honey);color:var(--ink);border-color:var(--ink)}

/* rail */
#rail{border-left:1.5px solid var(--line);overflow-y:auto;padding:16px 16px 20px;min-height:0}
.sec{margin-bottom:20px}
.sec h3{font:600 10px 'IBM Plex Mono';letter-spacing:.18em;text-transform:uppercase;margin-bottom:11px;display:flex;justify-content:space-between;align-items:baseline}
.sec h3 .dim{color:var(--cream35);letter-spacing:.08em}
.deck{display:grid;grid-template-columns:1fr 1fr;gap:7px}
.dcell{display:flex;align-items:center;gap:9px;padding:6px 8px;border-radius:11px;text-align:left;border:1.5px solid transparent;transition:background .12s,border-color .12s}
.dcell:hover{background:rgba(255,242,217,.06)}
.dcell.sel{border-color:var(--honey-d);background:rgba(255,178,62,.10)}
.dcell canvas{width:38px;height:38px;border:1.5px solid var(--line2);border-radius:10px;background:var(--well);flex:none}
.dcell .nm{font-size:12px;font-weight:600;line-height:1.15}
.dcell kbd{margin-left:auto}
.faces{display:grid;grid-template-columns:repeat(5,1fr);gap:7px}
.face{border:1.5px solid var(--line2);border-radius:11px;background:var(--well);padding:0;transition:border-color .12s}
.face:hover{border-color:var(--cream50)}
.face.sel{border-color:var(--honey)}
.face canvas{width:100%;height:auto;display:block}
#talkForm{display:flex;gap:8px}
#talkInp{flex:1;min-width:0;font:500 12.5px 'Bricolage Grotesque';color:var(--cream);background:var(--well);border:1.5px solid var(--line2);border-radius:10px;padding:8px 11px;outline:none}
#talkInp:focus{border-color:var(--honey-d)}
#talkInp::placeholder{color:var(--cream35)}
.exrow{display:flex;gap:8px;flex-wrap:wrap}
.apitbl{width:100%;border-collapse:collapse;font-size:11px}
.apitbl td{padding:6px 8px;border-bottom:1px solid var(--line);vertical-align:top}
.apitbl td:first-child{font:500 10px 'IBM Plex Mono';color:var(--honey);white-space:nowrap}
.apitbl td:last-child{color:var(--cream70);line-height:1.4}
#log{background:var(--well);border:1.5px solid var(--line);border-radius:11px;padding:9px 11px;height:118px;overflow-y:auto;font:400 10px/1.75 'IBM Plex Mono';color:var(--cream50)}
#log b{color:var(--honey);font-weight:600}

/* modal */
.modal{position:fixed;inset:0;z-index:60;display:none;align-items:center;justify-content:center;background:rgba(10,6,2,.66)}
.modal.on{display:flex}
.mbox{width:min(780px,94vw);max-height:88vh;display:flex;flex-direction:column;background:var(--panel2);border:1.5px solid var(--line2);border-radius:18px;padding:18px 20px 20px;box-shadow:0 30px 80px rgba(0,0,0,.6)}
.mbox h2{font-size:18px;font-weight:800;display:flex;align-items:center;gap:10px;margin-bottom:6px}
.mbox h2 .btn{margin-left:auto}
.mbox .lede{font-size:12.5px;color:var(--cream70);margin-bottom:12px;line-height:1.5}
#promptPre{flex:1;overflow:auto;background:var(--well);border:1.5px solid var(--line);border-radius:12px;padding:14px 16px;font:400 11px/1.7 'IBM Plex Mono';color:#F2E4C8;white-space:pre-wrap}

#toasts{position:fixed;left:18px;bottom:18px;z-index:70;display:flex;flex-direction:column;gap:8px}
.toast{background:var(--cream);color:var(--ink);font:500 11.5px 'IBM Plex Mono';padding:9px 14px;border-radius:10px;opacity:0;transform:translateY(8px);transition:.28s;box-shadow:3px 4px 0 rgba(0,0,0,.35)}
.toast.in{opacity:1;transform:none}

@media (max-width:960px){body{overflow:auto}main{grid-template-columns:1fr}#stage{height:56vh;margin:12px}#rail{border-left:none;border-top:1.5px solid var(--line)}}
</style>
</head>
