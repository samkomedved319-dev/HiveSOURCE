      else if(p.type==='z'){g.save();g.translate(p.x,p.y);g.rotate(p.rot||0);
        g.font=`600 ${p.s*(0.7+0.7*(p.age/p.dur))}px 'IBM Plex Mono',monospace`;
        g.fillStyle=CREAM;g.fillText('z',0,0);g.restore();}
      else if(p.type==='spark'){star4(g,p.x,p.y,p.s*(0.5+0.7*al));g.fillStyle=HONEY_D;g.fill();}
      else if(p.type==='dot'){g.beginPath();g.arc(p.x,p.y,p.s*(0.5+Math.min(1,p.age/140)*0.8),0,TAU);g.fillStyle=CREAM;g.fill();}
      else if(p.type==='confetti'){g.save();g.translate(p.x,p.y);g.rotate(p.rot);
        g.fillStyle=p.col;g.fillRect(-p.s/2,-p.s/4,p.s,p.s/2);g.restore();}
      else if(p.type==='puff'){g.beginPath();g.arc(p.x,p.y,p.s*(0.6+p.age/300),0,TAU);
        g.fillStyle=`rgba(190,175,150,${0.35*al})`;g.fill();}
    }
    g.globalAlpha=1;
    if(this.bubble)this._placeBubble();
  }
  _placeBubble(){
    const R=this.R,b=this.bubble;
    const by=this.pos.y-R*1.9, bw=b.offsetWidth;
    let bx=this.pos.x+R*1.05;
    b.style.top=Math.round(by)+'px';
    if(bx+bw>this.W-6){
      b.classList.add('hex-flip');
      b.style.left=Math.round(this.pos.x-R*1.05)+'px';
      b.style.translate='-100% 0';
    }else{
      b.classList.remove('hex-flip');
      b.style.left=Math.round(bx)+'px';
      b.style.translate='none';
    }
  }
  sfxPing(){blip(980,520,0.22,0.03);}
  sfxHm(){blip(560,660,0.14,0.016);}
  sfxDone(){[523,659,784,1046].forEach((f,i)=>setTimeout(()=>pluck(f,0.045),i*95));}
  sfxError(){blip(220,110,0.32,0.05,'sawtooth');setTimeout(()=>blip(180,90,0.30,0.04,'sawtooth'),120);}
}

/* ---- public mount surface ---- */
const HexMascot={
  mount:(el,opts)=>new HexEngine(el,opts),
  setSound:b=>{soundOn=!!b;}
};
if(typeof window!=='undefined')window.HexMascot=HexMascot;
/* ═══════════════════════════════════════════════════════════════════
   ═══ HEX ENGINE END                                               ═══
   ═══════════════════════════════════════════════════════════════════ */
</script>

<script>
/* ================= playground harness (kit only — do NOT ship) ================= */
'use strict';
const $=id=>document.getElementById(id);
const STATE_META=[
  ['idle','Idle'],['thinking','Thinking'],['searching','Searching'],['coding','Writing code'],
  ['working','Running'],['done','Done'],['error','Error'],['sleep','Sleep'],
];

/* mount */
const hex=HexMascot.mount('#hexHost',{w:380,h:320,autoSleep:60000});
window.hex=hex;

/* ---- event log ---- */
const logEl=$('log');
function log(evt,detail){
  const row=document.createElement('div');
  const ts=(performance.now()/1000).toFixed(1).padStart(6,' ');
  row.innerHTML=`<b>${evt}</b> ${detail||''} <span style="color:var(--cream35)">· ${ts}s</span>`;
  logEl.appendChild(row);
  while(logEl.children.length>28)logEl.firstChild.remove();
  logEl.scrollTop=logEl.scrollHeight;
}

/* ---- state deck (live animated thumbnails) ---- */
const deckCells={};
STATE_META.forEach(([k,label],i)=>{
  const b=document.createElement('button');
  b.className='dcell';
  const c=document.createElement('canvas');c.width=76;c.height=76;b.appendChild(c);
  const n=document.createElement('span');n.className='nm';n.textContent=label;b.appendChild(n);
  const kb=document.createElement('kbd');kb.textContent=i+1;b.appendChild(kb);
  b.addEventListener('click',()=>hex.setState(k));
  $('deck').appendChild(b);deckCells[k]=b;
});
const faceCells={};
Object.keys(EXPR).forEach(k=>{
  const b=document.createElement('button');b.className='face';b.title=EXPR[k].label;
  const c=document.createElement('canvas');c.width=88;c.height=88;b.appendChild(c);
  b.addEventListener('click',()=>hex.setFace(k));
  $('faces').appendChild(b);faceCells[k]={btn:b,cnv:c};
});

/* thumbnail renderer */
function miniBlob(g,w,h,E,t){
  const R=h*0.34;
  g.fillStyle='rgba(0,0,0,.35)';
  g.beginPath();g.ellipse(w/2,h/2+R*1.18,R*0.78,R*0.13,0,0,TAU);g.fill();
  renderBlob(g,{x:w/2,y:h/2+R*0.10,R,E,t,look:{x:0,y:0.06},blink:1,ant:{x:0,y:0}});
}
function renderStateMini(c,k,t){
  const g=c.getContext('2d');
  g.setTransform(2,0,0,2,0,0);g.clearRect(0,0,38,38);
  miniBlob(g,38,38,STATE_FACE[k]||EXPR.happy,t*(k==='searching'?1.6:1));
  g.save();g.translate(19,19);
  if(k==='working'){
    g.beginPath();g.arc(0,0,16,t*2.4,t*2.4+1.5);
    g.strokeStyle=HONEY;g.lineWidth=2.2;g.lineCap='round';g.stroke();
  }else if(k==='done'){
    g.beginPath();g.arc(11,-11,5.4,0,TAU);g.fillStyle=HONEY;g.fill();g.lineWidth=1.4;g.strokeStyle=INK;g.stroke();
    g.beginPath();g.moveTo(8.6,-11);g.lineTo(10.4,-9.2);g.lineTo(13.6,-13.4);
    g.lineWidth=1.8;g.lineCap='round';g.strokeStyle=INK;g.stroke();
  }else if(k==='error'){
    g.beginPath();g.arc(-11,-11,5.2,0,TAU);g.fillStyle=RED;g.fill();g.lineWidth=1.4;g.strokeStyle=INK;g.stroke();
    g.fillStyle=CREAM;g.fillRect(-11.7,-14.4,1.4,4.6);
    g.beginPath();g.arc(-11,-8.2,0.9,0,TAU);g.fill();
  }else if(k==='searching'){
    g.beginPath();g.arc(0,0,16.5,0,TAU);g.strokeStyle='rgba(255,178,62,.4)';g.lineWidth=1.2;g.stroke();
  }else if(k==='thinking'){
    for(let i=0;i<3;i++){const a=t*3.2+i*TAU/3;
      g.beginPath();g.arc(Math.cos(a)*5,-16+Math.sin(a)*2,1.3,0,TAU);g.fillStyle=HONEY_D;g.fill();}
  }else if(k==='coding'){
    rrect(g,6,3,17,12,2.5);g.fillStyle=CREAM;g.fill();g.lineWidth=1.3;g.strokeStyle=INK;g.stroke();
    g.fillStyle=INK;g.fillRect(9,7,8,1.6);g.fillRect(9,10.5,11,1.6);
  }else if(k==='sleep'){
    g.font="600 9px 'IBM Plex Mono'";g.fillStyle=CREAM;g.fillText('z',12,-13);
  }
  g.restore();
}
setInterval(()=>{
  const t=performance.now()/1000;
  STATE_META.forEach(([k])=>renderStateMini(deckCells[k].querySelector('canvas'),k,t));
  Object.keys(EXPR).forEach((k,i)=>{
    const o=faceCells[k],g=o.cnv.getContext('2d');
    g.setTransform(2,0,0,2,0,0);g.clearRect(0,0,44,44);
    miniBlob(g,44,44,EXPR[k],t+i*0.7);
  });
},150);

/* ---- exports ---- */
function download(c,name){
  c.toBlob(b=>{
    const u=URL.createObjectURL(b),a=document.createElement('a');
    a.href=u;a.download=name;a.click();
    setTimeout(()=>URL.revokeObjectURL(u),3000);
  });
}
 $('btnPng').addEventListener('click',()=>{
  const c=document.createElement('canvas');c.width=c.height=1024;
  renderBlob(c.getContext('2d'),{x:512,y:560,R:330,E:{...hex.faceParams()},t:1.35,look:{x:0,y:0.06},blink:1,ant:{x:0,y:0}});
  download(c,'hex-mascot.png');
  toast('saved hex-mascot.png — 1024, transparent');
});
 $('btnSheet').addEventListener('click',()=>{
  const c=document.createElement('canvas');c.width=960;c.height=560;
  const g=c.getContext('2d');
  STATE_META.forEach(([k],i)=>{
    const gx=(i%4)*240+120, gy=(i<4?150:400), R=80;
    g.save();g.translate(gx,gy);
    renderBlob(g,{x:0,y:0,R,E:{...EXPR.happy,...(STATE_FACE[k]||{})},t:1+i*0.9,look:{x:0,y:0.05},blink:1,ant:{x:0,y:0}});
    if(k==='done')drawDoneFX(g,R,1);
    if(k==='error')drawErrorFX(g,R,1);
    g.restore();
    g.font="600 11px 'IBM Plex Mono',monospace";g.fillStyle=INK;g.textAlign='center';
    g.fillText(k.toUpperCase(),gx,gy+R*1.35);
  });
  download(c,'hex-states-sheet.png');
  toast('saved hex-states-sheet.png — 8 poses, 240px cells');
});
function toast(m){
  const el=document.createElement('div');el.className='toast';el.textContent=m;
  $('toasts').appendChild(el);
  requestAnimationFrame(()=>el.classList.add('in'));
  setTimeout(()=>{el.classList.remove('in');setTimeout(()=>el.remove(),320);},2400);
}

/* ---- engine events -> UI ---- */
hex.on('state',s=>{
  log('state',s);
  Object.entries(deckCells).forEach(([k,b])=>b.classList.toggle('sel',k===s));
});
hex.on('face',k=>{
  log('face',k);
  Object.entries(faceCells).forEach(([kk,o])=>o.btn.classList.toggle('sel',kk===k));
});
hex.on('say',m=>log('say',`"${m}"`));
hex.on('wave',()=>log('wave',''));
hex.on('doze',()=>log('doze','auto-sleep — poke him to wake'));
hex.on('fps',f=>$('fps').textContent=`RIG ${hex.N}PTS · 0 DEPS · ${f} FPS`);

/* ---- talk / light / sound ---- */
 $('talkForm').addEventListener('submit',e=>{
  e.preventDefault();
  const v=$('talkInp').value.trim();
  if(v){hex.say(v);$('talkInp').value='';}
  else hex.say(pick(['bee good!','0x48 0x49 spells "HI"','buzz buzz','thinking in hex']));
});
 $('chipLight').addEventListener('click',e=>{
  const on=$('stage').classList.toggle('light');
  e.currentTarget.classList.toggle('on',on);
});
 $('sndBtn').addEventListener('click',e=>{
  const muted=e.currentTarget.classList.toggle('muted');
  HexMascot.setSound(!muted);
  if(!muted)blip(660,880,0.1,0.04);
});

/* ---- prompt modal ---- */
const modal=$('promptModal'),promptPre=$('promptPre');
promptPre.textContent=$('promptSrc').textContent.trim();
 $('promptBtn').addEventListener('click',()=>modal.classList.add('on'));
 $('promptClose').addEventListener('click',()=>modal.classList.remove('on'));
modal.addEventListener('click',e=>{if(e.target===modal)modal.classList.remove('on');});
 $('promptCopy').addEventListener('click',()=>{
  navigator.clipboard.writeText(promptPre.textContent)
    .then(()=>toast('prompt copied — now attach this file to your AI tool'))
    .catch(()=>toast('copy blocked — select the text manually'));
});
addEventListener('keydown',e=>{
  if(e.target.tagName==='INPUT')return;
  if(e.key==='Escape')modal.classList.remove('on');
  const map={'1':'idle','2':'thinking','3':'searching','4':'coding','5':'working','6':'done','7':'error','8':'sleep'};
  if(map[e.key])hex.setState(map[e.key]);
  else if(e.key==='t'||e.key==='T'){e.preventDefault();$('talkInp').focus();}
});

/* ---- boot ---- */
setTimeout(()=>hex.wave(),650);
setTimeout(()=>hex.say("hey! i'm HEX — try the states, or copy the AI prompt to ship me."),1050);
</script>
</body>
</html>