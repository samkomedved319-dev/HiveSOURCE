        this.parts.push({type:'spark',x:this.pos.x+Math.cos(a)*R*1.32,y:this.pos.y+Math.sin(a)*R*1.32,
          vx:Math.cos(a)*0.04,vy:Math.sin(a)*0.04-0.02,life:420,dur:420,s:rnd(3,5.5),age:0});}
    }
    if(st==='sleep'){
