      if(this.zT<0){this.zT=900;
        this.parts.push({type:'z',x:this.pos.x+R*0.55,y:this.pos.y-R*0.95,vx:0.02,vy:-0.028,life:2600,dur:2600,s:rnd(11,15),rot:rnd(-0.3,0.3),age:0});}
    }
